# Copy to .env and adjust. .env is gitignored.

# LLM backend: ollama | stub
LLM_BACKEND=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Note import (paste a note / link) uses a bigger model than the rest of the app. Default: qwen2.5:14b-instruct
# NOTE_OLLAMA_MODEL=qwen2.5:14b-instruct

# Later (optional):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: your own Xiaohongshu web login cookie, so "paste link" can read a note page you are allowed to see.
# Copy it yourself from your logged-in browser (DevTools > Application > Cookies, or Network > a request > Cookie header)
# into this one line. It is only sent to xiaohongshu.com, never logged, never returned by any API. Expires in 1-4 weeks.
# Prefer a throwaway account: Xiaohongshu's terms forbid automated access, so the account could be rate-limited.
# XHS_COOKIE=

# Amap (高德) — maps for mainland China cities. Apply at lbs.amap.com (personal developer), create two keys:
#   Web service key -> AMAP_WEB_KEY (backend only, never sent to the browser)
#   Web (JS API) key + its security code -> AMAP_JS_KEY / AMAP_JS_SECRET (domain whitelist: localhost)
# Without them the map falls back to OpenStreetMap. Calls are counted per month and stop at our own caps (app/maps/quota.py).
# AMAP_WEB_KEY=
# AMAP_JS_KEY=
# AMAP_JS_SECRET=
